/// Les constats du diagnostic de catalogue : droits, retention, nettoyage,
/// version de schema, reglages serveur.
/// 
/// LE DOMAINE "DROITS" EST LE PREMIER, ET IL Y A UNE RAISON PRECISE.
/// Les vues du catalogue SSISDB sont filtrees par permissions. Un compte sans
/// droit suffisant ne recoit pas un refus : il recoit ZERO LIGNE. Un rapport
/// parfaitement vide et un parc parfaitement calme se ressemblent trait pour
/// trait. Constater les roles est donc la condition de lecture de tout le
/// reste du rapport.
/// 
/// La colonne Lecture porte la phrase a afficher : le diagnostic ne rend pas
/// des valeurs brutes a interpreter, il rend des constats deja formules.
table ContexteCatalogue
	lineageTag: 6f18d14c-d21f-4597-9acc-aff1fbcf8626

	column Domaine
		dataType: string
		lineageTag: c5000000-0000-4000-8000-000000000001
		summarizeBy: none
		sourceColumn: domaine

	column Constat
		dataType: string
		lineageTag: c5000000-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: constat

	column Valeur
		dataType: string
		lineageTag: c5000000-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: valeur

	column Lecture
		dataType: string
		lineageTag: c5000000-0000-4000-8000-000000000004
		summarizeBy: none
		sourceColumn: lecture

	partition ContexteCatalogue = m
		mode: import
		source =
				let
				    Source = fnLireCsv("CatalogContext.csv", {"domaine", "constat", "valeur", "lecture"})
				in
				    Source

