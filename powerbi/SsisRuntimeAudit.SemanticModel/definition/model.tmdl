model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: fr-FR
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Collecte","ContexteCatalogue","Executables","Executions","Extractions","Messages","Packages","Parametres","PhasesComposants","StatistiquesFlux","VersionsProjet","DossierBase","DossierRun","CheminBase","CollectesDisponibles","CheminCollecte","fnLireCsv","fnHorodatage","fnNombre","fnBooleen","fnHeureServeur","fnHeuresServeurTable","DecalageReferenceMinutes","fnClePackage"]

ref table Calendrier
ref table Collecte
ref table ContexteCatalogue
ref table Executables
ref table Executions
ref table Extractions
ref table GrilleTemps
ref table Messages
ref table Mesures
ref table Packages
ref table SeuilGantt
ref table Parametres
ref table PhasesComposants
ref table StatistiquesFlux
ref table VersionsProjet

ref cultureInfo fr-FR

