{
  "name": "SsisRuntimeAudit.json",
  "dataColors": [
    "#3B82F6",
    "#2BB9A6",
    "#F2A93B",
    "#E8635A",
    "#8B5CF6",
    "#0EA5E9",
    "#64748B",
    "#14B8A6",
    "#F97316",
    "#DC2626"
  ],
  "good": "#2BB9A6",
  "neutral": "#F2A93B",
  "bad": "#E8635A",
  "maximum": "#1D4ED8",
  "center": "#93C5FD",
  "minimum": "#EFF6FF",
  "null": "#CBD5E1",
  "background": "#F5F7FA",
  "secondaryBackground": "#FFFFFF",
  "tableAccent": "#3B82F6",
  "foreground": "#1F2937",
  "foregroundNeutralSecondary": "#4B5563",
  "foregroundNeutralTertiary": "#9CA3AF",
  "textClasses": {
    "title": {
      "fontSize": 16,
      "fontFace": "Segoe UI Semibold",
      "color": "#111827"
    },
    "header": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "label": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#374151"
    },
    "callout": {
      "fontSize": 32,
      "fontFace": "Segoe UI Light",
      "color": "#111827"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 100
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 14,
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#111827"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 11,
            "color": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#374151"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "bold": true
          }
        ]
      }
    }
  }
}